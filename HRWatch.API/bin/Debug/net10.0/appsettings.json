{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "Hangfire": "Information",
        "System": "Warning"
      }
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "Server=(localdb)\\MSSQLLocalDB;Database=HRWatchDb;Trusted_Connection=True;MultipleActiveResultSets=True;TrustServerCertificate=True"
  },
  "JwtSettings": {
    "SecretKey": "HRWatchSuperSecretKeyThatIsAtLeast32BytesLong!",
    "Issuer": "HRWatchAPI",
    "Audience": "HRWatchApp",
    "ExpiryMinutes": 120
  },
  "ExternalApis": {
    "EmployeeApi": {
      "BaseUrl": "https://api.company.com/employees",
      "TimeoutSeconds": 30
    },
    "AttendanceApi": {
      "BaseUrl": "https://api.company.com/attendance",
      "TimeoutSeconds": 30
    },
    "LeaveApi": {
      "BaseUrl": "https://api.company.com/leave",
      "TimeoutSeconds": 30
    },
    "HolidayApi": {
      "BaseUrl": "https://api.company.com/holidays",
      "TimeoutSeconds": 30
    }
  },
  "AllowedHosts": "*",
  "Swagger": {
    "Title": "HRWatch API",
    "Version": "v1",
    "Description": "Enterprise HR Monitoring Platform API"
  }
}
